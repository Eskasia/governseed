{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent-governance-starter/governance-impact-run.schema.json",
  "title": "Governance Impact Paired Run",
  "type": "object",
  "required": ["schemaVersion", "runId", "seed", "arms"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "arms": {
      "type": "object",
      "required": ["baseline", "governed"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/arm"
        },
        "governed": {
          "$ref": "#/$defs/arm"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "arm": {
      "type": "object",
      "required": [
        "scenarioHash",
        "runtime",
        "model",
        "config",
        "starterCommit",
        "execution",
        "acceptanceChecks",
        "requirements",
        "scope",
        "prohibitions",
        "documentChecks",
        "time",
        "tokens"
      ],
      "properties": {
        "scenarioHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime": {
          "type": "string",
          "enum": ["synthetic", "codex", "claude", "antigravity"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "string",
          "minLength": 1
        },
        "starterCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "acceptanceChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkResult"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementResult"
          }
        },
        "scope": {
          "$ref": "#/$defs/scopeEvidence"
        },
        "prohibitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/prohibitionResult"
          }
        },
        "documentChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/documentResult"
          }
        },
        "privacyChecks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkResult"
          }
        },
        "time": {
          "$ref": "#/$defs/timeTelemetry"
        },
        "tokens": {
          "$ref": "#/$defs/tokenTelemetry"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["status", "repairRounds"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "timeout"]
        },
        "repairRounds": {
          "type": "integer",
          "minimum": 0
        },
        "errorCode": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "checkResult": {
      "type": "object",
      "required": ["id", "passed", "critical"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "critical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "requirementResult": {
      "type": "object",
      "required": ["id", "omitted"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "omitted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "prohibitionResult": {
      "type": "object",
      "required": ["id", "violated", "critical"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "violated": {
          "type": "boolean"
        },
        "critical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "documentResult": {
      "type": "object",
      "required": ["id", "drifted", "critical"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "drifted": {
          "type": "boolean"
        },
        "critical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "scopeEvidence": {
      "type": "object",
      "required": ["changedPaths", "allowedPaths", "forbiddenPaths"],
      "properties": {
        "changedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "allowedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "forbiddenPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "timeTelemetry": {
      "type": "object",
      "required": ["availability", "wallTimeMs"],
      "properties": {
        "availability": {
          "type": "string",
          "enum": ["available", "unavailable"]
        },
        "wallTimeMs": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tokenTelemetry": {
      "type": "object",
      "required": ["availability", "total"],
      "properties": {
        "availability": {
          "type": "string",
          "enum": ["available", "unavailable"]
        },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
