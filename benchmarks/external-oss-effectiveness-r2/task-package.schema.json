{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.dev/schemas/external-oss-effectiveness-r2/task-package.schema.json",
  "title": "GovernSeed effectiveness R2 confirmatory task package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "experimentId", "revision", "evidenceClass", "taskId",
    "repository", "upstream", "seed", "publicTask", "publicTest", "pathPolicy",
    "hiddenOracle", "reconstruction", "runtime", "status", "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experimentId": { "const": "GS-OSS-2026-08-05-EFFECT-R2" },
    "revision": { "const": 2 },
    "evidenceClass": { "const": "external-observational" },
    "taskId": { "type": "string", "pattern": "^TASK-OSS-1[1-8]$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "upstream": { "$ref": "#/$defs/upstream" },
    "seed": { "$ref": "#/$defs/seed" },
    "publicTask": { "$ref": "#/$defs/publicArtifact" },
    "publicTest": { "$ref": "#/$defs/publicTest" },
    "pathPolicy": { "$ref": "#/$defs/pathPolicy" },
    "hiddenOracle": { "$ref": "#/$defs/hiddenOracle" },
    "reconstruction": { "$ref": "#/$defs/reconstruction" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "status": { "const": "PASS" },
    "claimBoundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stringArray": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "exitCode", "status"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "exitCode": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["FAIL_EXPECTED", "PASS"] }
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryUrl", "pullRequestUrl", "baseCommit", "fixCommit", "baseReachable", "fixReachable", "fixGitTree"],
      "properties": {
        "repositoryUrl": { "type": "string", "pattern": "^https://github\\.com/.+\\.git$" },
        "pullRequestUrl": { "type": "string", "pattern": "^https://github\\.com/.+/pull/[0-9]+$" },
        "baseCommit": { "$ref": "#/$defs/sha1" },
        "fixCommit": { "$ref": "#/$defs/sha1" },
        "baseReachable": { "const": true },
        "fixReachable": { "const": true },
        "fixGitTree": { "$ref": "#/$defs/sha1" }
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["sealedSeedCommit", "sealedSeedGitTree", "sealedSeedTreeSha256", "overlayApplied"],
      "properties": {
        "sealedSeedCommit": { "$ref": "#/$defs/sha1" },
        "sealedSeedGitTree": { "$ref": "#/$defs/sha1" },
        "sealedSeedTreeSha256": { "$ref": "#/$defs/sha256" },
        "overlayApplied": { "const": false }
      }
    },
    "publicArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^benchmarks/external-oss-effectiveness-r2/tasks/TASK-OSS-1[1-8]/public-task\\.md$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "publicTest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "command", "commandIdentitySha256", "parent", "fix"],
      "properties": {
        "path": { "type": "string", "pattern": "^benchmarks/external-oss-effectiveness-r2/tasks/TASK-OSS-1[1-8]/public-test\\.(py|cjs|ts)$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "command": { "$ref": "#/$defs/stringArray" },
        "commandIdentitySha256": { "$ref": "#/$defs/sha256" },
        "parent": { "$ref": "#/$defs/result" },
        "fix": { "$ref": "#/$defs/result" }
      }
    },
    "pathPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowOnly", "allowedPaths", "forbiddenPaths", "sha256"],
      "properties": {
        "allowOnly": { "const": true },
        "allowedPaths": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "hiddenOracle": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "commandIdentitySha256", "runnerOwned", "sourceCommitted", "exposedToExecutionAgent", "identitySeparatedFromPublicTest", "parent", "fix"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "commandIdentitySha256": { "$ref": "#/$defs/sha256" },
        "runnerOwned": { "const": true },
        "sourceCommitted": { "const": false },
        "exposedToExecutionAgent": { "const": false },
        "identitySeparatedFromPublicTest": { "const": true },
        "parent": { "$ref": "#/$defs/result" },
        "fix": { "$ref": "#/$defs/result" }
      }
    },
    "reconstructionItem": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "sealedSeedCommit", "sealedSeedGitTree", "sealedSeedTreeSha256"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 2 },
        "sealedSeedCommit": { "$ref": "#/$defs/sha1" },
        "sealedSeedGitTree": { "$ref": "#/$defs/sha1" },
        "sealedSeedTreeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reconstruction": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "exactShaFetchVerified", "runs", "stable", "status"],
      "properties": {
        "mode": { "const": "exact-upstream-parent" },
        "exactShaFetchVerified": { "const": true },
        "runs": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/$defs/reconstructionItem" }
        },
        "stable": { "const": true },
        "status": { "const": "PASS" }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "runtimeVersion", "dependencyInstallCommand", "preTestCommand", "environment", "publicTestWorkingDirectory"],
      "properties": {
        "language": { "enum": ["Python", "JavaScript", "TypeScript"] },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "dependencyInstallCommand": { "$ref": "#/$defs/stringArray" },
        "preTestCommand": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stringArray" }
          ]
        },
        "environment": {
          "type": "object", "additionalProperties": false,
          "properties": { "PYTHONPATH": { "const": "." } }
        },
        "publicTestWorkingDirectory": { "const": "." }
      }
    }
  }
}
