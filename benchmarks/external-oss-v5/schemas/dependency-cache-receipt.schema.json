{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.dev/schemas/external-oss-v5/dependency-cache-receipt.schema.json",
  "title": "GovernSeed V5 measured dependency-cache receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "evidenceClass",
    "taskId",
    "repository",
    "status",
    "upstreamBaseCommit",
    "sealedSeedCommit",
    "sealedSeedTreeSha256",
    "taskSeedContractSha256",
    "cacheSha256",
    "manifestSha256",
    "cacheFilesSha256",
    "runtimeIdentity",
    "preparationNetworkUsed",
    "measuredNetworkUsed",
    "cacheReadOnlyObserved",
    "publicTestSmokePass",
    "negativeCacheMissBlocked",
    "containmentObserved",
    "lockfileModified",
    "credentialIncluded",
    "fallbackDownload",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "benchmarkId": {"const": "GS-OSS-2026-08-01-V5"},
    "evidenceClass": {"const": "external-observational"},
    "taskId": {"type": "string", "pattern": "^TASK-OSS-[0-9]{2}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "status": {"enum": ["READY", "BLOCKED", "NOT_RUN"]},
    "upstreamBaseCommit": {"$ref": "#/$defs/sha1"},
    "sealedSeedCommit": {"$ref": "#/$defs/sha1"},
    "sealedSeedTreeSha256": {"$ref": "#/$defs/sha256"},
    "taskSeedContractSha256": {"$ref": "#/$defs/sha256"},
    "cacheSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "manifestSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "cacheFilesSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "runtimeIdentity": {"type": "object"},
    "preparationNetworkUsed": {"type": ["boolean", "null"]},
    "measuredNetworkUsed": {"type": ["boolean", "null"]},
    "cacheReadOnlyObserved": {"type": ["boolean", "null"]},
    "publicTestSmokePass": {"type": ["boolean", "null"]},
    "negativeCacheMissBlocked": {"type": ["boolean", "null"]},
    "containmentObserved": {
      "type": ["object", "null"],
      "properties": {
        "networkNone": {"type": "boolean"},
        "readonlyRoot": {"type": "boolean"},
        "capDropAll": {"type": "boolean"},
        "noNewPrivileges": {"type": "boolean"},
        "nonRootUser": {"type": "boolean"},
        "limitsObserved": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "lockfileModified": {"type": ["boolean", "null"]},
    "credentialIncluded": {"type": ["boolean", "null"]},
    "fallbackDownload": {"type": ["boolean", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
