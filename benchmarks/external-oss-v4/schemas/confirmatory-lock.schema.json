{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.dev/schemas/external-oss-v4/confirmatory-lock.schema.json",
  "title": "GovernSeed External OSS confirmatory benchmark lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkType", "benchmarkId", "evidenceClass", "repositories", "repetitionsPerArm", "arms", "expectedRunCount"],
  "properties": {
    "schemaVersion": {"const": 1},
    "benchmarkType": {"const": "confirmatory"},
    "benchmarkId": {"type": "string", "pattern": "^GS-OSS-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
    "evidenceClass": {"const": "external-observational"},
    "repositories": {"type": "array", "minItems": 8, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/repository"}},
    "repetitionsPerArm": {"type": "integer", "minimum": 3},
    "arms": {"const": ["baseline", "governed"]},
    "expectedRunCount": {"type": "integer", "minimum": 48}
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["id", "repository", "seedTreeSha256", "seedCommitSha", "taskId", "taskSha256", "publicTestCommandSha256", "hiddenOracleSha256", "dependencyCacheSha256", "allowedPaths", "forbiddenPaths", "timeoutSeconds", "tokenCeiling"],
      "properties": {
        "id": {"type": "string"}, "repository": {"type": "string"},
        "seedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "seedCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "taskId": {"type": "string"}, "taskSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "publicTestCommandSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hiddenOracleSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "dependencyCacheSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "allowedPaths": {"type": "array"}, "forbiddenPaths": {"type": "array"}, "timeoutSeconds": {"type": "integer"}, "tokenCeiling": {"type": "integer"}
      }
    }
  }
}
