{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.dev/schemas/external-oss-v4/run-record.schema.json",
  "title": "V4 measured run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "evidenceClass", "runId", "repositoryId", "taskId", "arm", "repetition", "seedTreeSha256", "status", "networkMode", "credentialNamesPassed", "dependencyInstall", "publicTests", "hiddenTests", "claims"],
  "properties": {
    "schemaVersion": {"const": 1}, "benchmarkId": {"const": "GS-OSS-2026-08-01-V4"}, "evidenceClass": {"const": "external-observational"},
    "runId": {"type": "string", "pattern": "^RUN-OSS-[0-9]{2}-(BASELINE|GOVERNED)-R[1-3]$"},
    "repositoryId": {"type": "string", "pattern": "^OSS-[0-9]{2}$"}, "taskId": {"type": "string", "pattern": "^TASK-OSS-[0-9]{2}$"},
    "arm": {"enum": ["baseline", "governed"]}, "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
    "seedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "networkMode": {"const": "none"}, "credentialNamesPassed": {"type": "array", "maxItems": 0},
    "dependencyInstall": {"const": "NOT_ALLOWED"}, "publicTests": {"type": "object"}, "hiddenTests": {"type": "object"},
    "claims": {"type": "object"}
  }
}
