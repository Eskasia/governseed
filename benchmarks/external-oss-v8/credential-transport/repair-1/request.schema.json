{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gs-oss-2026-08-02-v8-g2-repair-1-request",
  "title": "GovernSeed V8 G2 repair-1 proxy request",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "input", "max_output_tokens", "response_format", "metadata"],
  "properties": {
    "model": { "const": "gpt-5.6-luna" },
    "input": {
      "type": ["string", "array"],
      "maxLength": 1048576
    },
    "max_output_tokens": { "const": 8192 },
    "response_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "json_schema"],
      "properties": {
        "type": { "const": "json_schema" },
        "json_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "strict", "schema"],
          "properties": {
            "name": { "const": "governseed_response" },
            "strict": { "const": true },
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "additionalProperties", "required", "properties"],
              "properties": {
                "type": { "const": "object" },
                "additionalProperties": { "const": false },
                "required": {
                  "const": ["id", "model", "output", "usage"]
                },
                "properties": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_id", "run_id", "task_id"],
      "properties": {
        "benchmark_id": { "const": "GS-OSS-2026-08-02-V8" },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "task_id": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    }
  }
}
