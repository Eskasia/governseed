{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.dev/benchmarks/external-oss-v8/human-approval.schema.json",
  "title": "GovernSeed V8 G2 human approval record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "approvalStatus",
    "approvedBy",
    "approvedAt",
    "approvedDesignSha256",
    "approvedProxySha256",
    "approvedModelId",
    "scope",
    "limitationsAcknowledged",
    "approvalEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "const": "GS-OSS-2026-08-02-V8" },
    "approvalStatus": { "const": "APPROVED" },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["Luna", "Sol", "Codex", "ChatGPT", "agent", "bot", "model"] }
    },
    "approvedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "approvedDesignSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvedProxySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvedModelId": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["latest", "Luna", "Sol"] }
    },
    "scope": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["credential-transport", "runtime-identity-canary", "v8-pilot"]
      },
      "contains": { "const": "credential-transport" },
      "allOf": [
        { "contains": { "const": "runtime-identity-canary" } },
        { "contains": { "const": "v8-pilot" } }
      ]
    },
    "limitationsAcknowledged": { "const": true },
    "approvalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {
          "enum": ["github-review", "signed-record", "manual-record"]
        },
        "reference": { "type": "string", "minLength": 1 }
      }
    }
  }
}
