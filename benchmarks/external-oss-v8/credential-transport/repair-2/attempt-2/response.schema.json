{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gs-oss-2026-08-02-v8-g2-repair-2-normalized-proxy-response",
  "title": "GovernSeed V8 G2 repair-2 normalized proxy response",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "output_text", "usage"],
  "properties": {
    "model": { "const": "gpt-5.6-luna" },
    "output_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4194304
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0, "maximum": 8192 }
      }
    }
  }
}
