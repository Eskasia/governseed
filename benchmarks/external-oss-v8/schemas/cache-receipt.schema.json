{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governseed/v8/cache-receipt.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "benchmarkId",
    "evidenceClass",
    "taskId",
    "status",
    "workspaceExecObserved",
    "workspaceMountExec",
    "workspaceMountNoexec",
    "runtimeBinaryExecutionPass",
    "measuredNetworkUsed",
    "cacheReadOnlyObserved",
    "readonlyRootObserved",
    "nonRootObserved",
    "publicTestSmokePass",
    "negativeCacheMissBlocked"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "const": "GS-OSS-2026-08-02-V8" },
    "evidenceClass": { "const": "external-observational" },
    "taskId": { "enum": ["TASK-OSS-01", "TASK-OSS-03", "TASK-OSS-09"] },
    "status": { "enum": ["READY", "BLOCKED", "FAILURE"] },
    "workspaceExecObserved": { "type": "boolean" },
    "workspaceMountExec": { "type": "boolean" },
    "workspaceMountNoexec": { "type": "boolean" },
    "runtimeBinaryExecutionPass": { "type": "boolean" },
    "measuredNetworkUsed": { "const": false },
    "cacheReadOnlyObserved": { "type": "boolean" },
    "readonlyRootObserved": { "type": "boolean" },
    "nonRootObserved": { "type": "boolean" },
    "publicTestSmokePass": { "type": "boolean" },
    "negativeCacheMissBlocked": { "type": "boolean" },
    "negativeCode": { "const": "DEPENDENCY_CACHE_INCOMPLETE" },
    "negativeExitCode": { "const": 42 },
    "vitestResolvedPath": { "type": "string", "minLength": 1 },
    "vitestVersionProbePass": { "type": "boolean" },
    "vitestSmokePass": { "type": "boolean" },
    "cacheBinaryCommitted": { "const": false },
    "credentialIncluded": { "const": false },
    "codexIncluded": { "const": false },
    "hiddenOracleIncluded": { "const": false }
  },
  "additionalProperties": true
}
