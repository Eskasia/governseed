{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.dev/benchmarks/external-oss-v8/runtime-identity-receipt.schema.json",
  "title": "GovernSeed V8 G2 runtime identity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "evidenceClass",
    "status",
    "codexVersion",
    "codexBinarySha256",
    "codexPackageIdentity",
    "modelId",
    "proxySha256",
    "credentialDesignSha256",
    "humanApprovalSha256",
    "ociImageDigest",
    "runnerReceiptSha256",
    "networkPolicySha256",
    "containmentPolicySha256",
    "canaryInputSha256",
    "canaryOutputSha256",
    "providerRequestIdHash",
    "containerCredentialNamesObserved",
    "networkNoneObserved",
    "proxyCleanupObserved",
    "processCleanupObserved",
    "claimDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "const": "GS-OSS-2026-08-02-V8" },
    "evidenceClass": { "const": "external-observational" },
    "status": { "const": "READY" },
    "codexVersion": { "type": "string", "minLength": 1 },
    "codexBinarySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "codexPackageIdentity": { "type": "string", "minLength": 1 },
    "modelId": { "const": "gpt-5.6-luna" },
    "proxySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "credentialDesignSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "humanApprovalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ociImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runnerReceiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "networkPolicySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "containmentPolicySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canaryInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canaryOutputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "providerRequestIdHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "containerCredentialNamesObserved": { "const": false },
    "networkNoneObserved": { "const": true },
    "proxyCleanupObserved": { "const": true },
    "processCleanupObserved": { "const": true },
    "claimDisposition": { "const": "RUNTIME_IDENTITY_ONLY" }
  }
}
