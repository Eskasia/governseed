{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governseed.example/schemas/autonomous-completion-delegation-manifest-v2.schema.json",
  "title": "GovernSeed autonomous completion delegation V2 preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "status",
    "repository",
    "experimentId",
    "experimentRevision",
    "baseManifest",
    "canonicalContract",
    "diagnosticRepairCandidate",
    "immutableFailedRunAccounting",
    "activationTarget",
    "ceilingRevision",
    "unchangedContractSections",
    "workflowRevision",
    "providerAndCostRevision",
    "mandatoryStops",
    "authorityBoundary",
    "selfBinding"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "manifestId": { "const": "GS-EFFECT-R2-AUTONOMOUS-COMPLETION-DELEGATION-V2" },
    "status": { "const": "PENDING_EXACT_REPAIR_MERGE_TARGET" },
    "repository": { "const": "Eskasia/governseed" },
    "experimentId": { "const": "GS-OSS-2026-08-05-EFFECT-R2" },
    "experimentRevision": { "const": 2 },
    "baseManifest": { "type": "object" },
    "canonicalContract": { "type": "object" },
    "diagnosticRepairCandidate": { "type": "object" },
    "immutableFailedRunAccounting": { "type": "object" },
    "activationTarget": { "type": "object" },
    "ceilingRevision": { "type": "object" },
    "unchangedContractSections": { "type": "array", "minItems": 1, "uniqueItems": true },
    "workflowRevision": { "type": "object" },
    "providerAndCostRevision": { "type": "object" },
    "mandatoryStops": { "type": "array", "minItems": 1, "uniqueItems": true },
    "authorityBoundary": { "type": "object" },
    "selfBinding": { "type": "string", "minLength": 1 }
  }
}
